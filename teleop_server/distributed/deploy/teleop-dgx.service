[Unit]
Description=DGX receiver for Jetson teleoperation sensors
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/home/midbar/ws/teleop_server/edge.env
ExecStart=/bin/bash /home/midbar/ws/teleop_server/teleop_server/distributed/deploy/run_dgx.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=600

[Install]
WantedBy=default.target
